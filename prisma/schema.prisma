generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model analytics_events {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  qr_code_id String?   @db.Uuid
  event_type String    @db.VarChar(50)
  user_agent String?
  ip_hash    String?   @db.VarChar(64)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  qr_codes   qr_codes? @relation(fields: [qr_code_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([qr_code_id, event_type], map: "idx_analytics_qr_event")
}

model qr_codes {
  id               String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  restaurant_id    String?            @db.Uuid
  label            String?            @default("Main QR") @db.VarChar(100)
  code_identifier  String             @unique @db.VarChar(100)
  created_at       DateTime?          @default(now()) @db.Timestamptz(6)
  analytics_events analytics_events[]
  restaurants      restaurants?       @relation(fields: [restaurant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([code_identifier], map: "idx_qr_codes_identifier")
}

model restaurants {
  id                 String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id            String     @db.VarChar(255)
  name               String     @db.VarChar(255)
  slug               String     @unique @db.VarChar(255)
  google_review_link String
  is_active          Boolean?   @default(true)
  created_at         DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?  @default(now()) @db.Timestamptz(6)
  qr_codes           qr_codes[]

  @@index([slug], map: "idx_restaurants_slug")
}
